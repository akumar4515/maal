# Copy to .env.local and restart `npm run dev`.
NEXT_PUBLIC_API_BASE_URL=https://halloween-backend-cria.onrender.com
# NEXT_PUBLIC_ENABLE_ADS_DEV=true
# Ads stay off until you add zones created for the maal domain:
# NEXT_PUBLIC_ADPROVIDER_TOP_BANNER_ZONE_ID=      (+ _CLASS)  home, under chips
# NEXT_PUBLIC_ADPROVIDER_MOBILE_BANNER_ZONE_ID=   (+ _CLASS)  home, phones
# NEXT_PUBLIC_ADPROVIDER_CONTENT_BANNER_1_ZONE_ID=(+ _CLASS)  in-grid
# NEXT_PUBLIC_ADPROVIDER_CONTENT_BANNER_2_ZONE_ID=(+ _CLASS)  watch, below player
# NEXT_PUBLIC_ADPROVIDER_SIDEBAR_BANNER_ZONE_ID=  (+ _CLASS)  watch, above related
# NEXT_PUBLIC_ADPROVIDER_PREROLL_VAST_URL=
# NEXT_PUBLIC_ADPROVIDER_POPUNDER_ZONE_ID=
